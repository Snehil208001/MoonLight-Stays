{
  "$schema": "https://design-tokens.org/schema.json",
  "name": "Moonlight Stays Design Tokens",
  "version": "1.0.0",
  "description": "Single source of truth for the Moonlight Stays design system. The Next.js app (moonlight-stays/) and the Android app (app/) MUST both implement these values. See DESIGN_SYSTEM.md for component specs and platform mapping.",
  "color": {
    "dark": {
      "background": {
        "base": "#0A0A1A",
        "raised": "#0F0F23",
        "overlay": "#15152E",
        "highlight": "#1A1A3E"
      },
      "glass": {
        "surface": "rgba(255,255,255,0.05)",
        "surfaceStrong": "rgba(255,255,255,0.08)",
        "surfaceHover": "rgba(255,255,255,0.10)",
        "border": "rgba(255,255,255,0.10)",
        "borderStrong": "rgba(255,255,255,0.20)",
        "scrim": "rgba(0,0,0,0.60)"
      },
      "accent": {
        "primary": "#00FFFF",
        "onPrimary": "#0A0A1A",
        "secondary": "#FF7F50",
        "onSecondary": "#0A0A1A"
      },
      "text": {
        "primary": "#FFFFFF",
        "secondary": "rgba(255,255,255,0.70)",
        "muted": "rgba(255,255,255,0.50)",
        "disabled": "rgba(255,255,255,0.38)"
      },
      "semantic": {
        "success": "#00E479",
        "warning": "#FFC857",
        "error": "#FF4D6D",
        "info": "#00FFFF",
        "rating": "#FFC857"
      }
    },
    "light": {
      "_comment": "Defined for future use. Both clients currently ship dark-only (html.dark on web, forced dark scheme on Android).",
      "background": {
        "base": "#F7F7FC",
        "raised": "#FFFFFF",
        "overlay": "#EFEFF8",
        "highlight": "#E4E4F4"
      },
      "glass": {
        "surface": "rgba(10,10,26,0.04)",
        "surfaceStrong": "rgba(10,10,26,0.06)",
        "surfaceHover": "rgba(10,10,26,0.08)",
        "border": "rgba(10,10,26,0.10)",
        "borderStrong": "rgba(10,10,26,0.20)",
        "scrim": "rgba(10,10,26,0.40)"
      },
      "accent": {
        "primary": "#00B8B8",
        "onPrimary": "#FFFFFF",
        "secondary": "#E85D2F",
        "onSecondary": "#FFFFFF"
      },
      "text": {
        "primary": "#0A0A1A",
        "secondary": "rgba(10,10,26,0.70)",
        "muted": "rgba(10,10,26,0.50)",
        "disabled": "rgba(10,10,26,0.38)"
      },
      "semantic": {
        "success": "#00A857",
        "warning": "#B87700",
        "error": "#D93654",
        "info": "#00B8B8",
        "rating": "#DFA100"
      }
    }
  },
  "typography": {
    "fontFamily": {
      "brand": "Plus Jakarta Sans",
      "fallback": ["Inter", "system-ui", "sans-serif"]
    },
    "scale": {
      "displayLarge": { "size": 48, "lineHeight": 56, "weight": 800, "tracking": -1.0 },
      "display":      { "size": 36, "lineHeight": 44, "weight": 800, "tracking": -0.5 },
      "headline":     { "size": 28, "lineHeight": 36, "weight": 700, "tracking": -0.25 },
      "titleLarge":   { "size": 22, "lineHeight": 28, "weight": 700, "tracking": 0 },
      "title":        { "size": 18, "lineHeight": 24, "weight": 600, "tracking": 0 },
      "bodyLarge":    { "size": 16, "lineHeight": 24, "weight": 400, "tracking": 0.15 },
      "body":         { "size": 14, "lineHeight": 20, "weight": 400, "tracking": 0.15 },
      "label":        { "size": 12, "lineHeight": 16, "weight": 500, "tracking": 0.4 },
      "button":       { "size": 15, "lineHeight": 20, "weight": 600, "tracking": 0.2 }
    }
  },
  "spacing": {
    "unit": 4,
    "xxs": 4,
    "xs": 8,
    "sm": 12,
    "md": 16,
    "lg": 24,
    "xl": 32,
    "xxl": 48,
    "xxxl": 64,
    "screenMargin": 16,
    "cardPadding": 16,
    "sectionGap": 32
  },
  "radius": {
    "sm": 8,
    "md": 12,
    "lg": 16,
    "xl": 24,
    "pill": 999,
    "_usage": {
      "chip": "pill",
      "button": "md",
      "textField": "md",
      "card": "lg",
      "image": "lg",
      "modal": "xl",
      "bottomSheet": "xl (top corners)"
    }
  },
  "elevation": {
    "_comment": "Dark glassmorphism uses shadows sparingly; depth comes from surface alpha + border. Glows mark interactive emphasis.",
    "level0": "none",
    "level1": "0 2px 8px rgba(0,0,0,0.30)",
    "level2": "0 8px 24px rgba(0,0,0,0.35)",
    "level3": "0 16px 48px rgba(0,0,0,0.45)",
    "glowCyan": "0 0 20px rgba(0,255,255,0.30), 0 0 40px rgba(0,255,255,0.20)",
    "glowCoral": "0 0 20px rgba(255,127,80,0.30)"
  },
  "motion": {
    "duration": {
      "fast": 150,
      "base": 250,
      "slow": 400,
      "screen": 500,
      "skeleton": 1500,
      "meshGradient": 15000
    },
    "easing": {
      "standard": "cubic-bezier(0.2, 0, 0, 1)",
      "decelerate": "cubic-bezier(0, 0, 0, 1)",
      "accelerate": "cubic-bezier(0.3, 0, 1, 1)"
    },
    "patterns": {
      "pageTransition": "fade + 24px slide-up, duration.screen, easing.decelerate",
      "buttonPress": "scale to 0.97, duration.fast",
      "cardHover": "translateY -4px + glow, duration.base",
      "modalIn": "fade scrim + scale 0.95→1, duration.base",
      "bottomSheetIn": "slide-up, duration.slow, easing.decelerate",
      "skeleton": "pulse opacity 0.4→0.7, duration.skeleton, infinite"
    }
  }
}
