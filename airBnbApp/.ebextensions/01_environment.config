option_settings:
  aws:elasticbeanstalk:application:environment:
    SPRING_PROFILES_ACTIVE: prod
    # Limit JVM heap - prevents starving OS on t3.micro (1GB RAM)
    JAVA_OPTS: "-Xms256m -Xmx384m"
  # Increase deployment timeout (default 600s) - Spring Boot can take 3-5 min to start
  aws:elasticbeanstalk:command:
    Timeout: 900
