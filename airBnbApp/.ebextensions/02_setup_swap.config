# Add 512MB swap file - prevents OOM on t3.micro (1GB RAM)
# Gives OS and EB health agents room when JVM uses heap
commands:
  01_add_swap:
    command: |
      if [ ! -f /var/swapfile ]; then
        dd if=/dev/zero of=/var/swapfile bs=1M count=512
        chmod 600 /var/swapfile
        mkswap /var/swapfile
        swapon /var/swapfile
        echo '/var/swapfile none swap sw 0 0' >> /etc/fstab
      fi
    ignoreErrors: false
